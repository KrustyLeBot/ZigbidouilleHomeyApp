  "flow": {
    "triggers": [
      {
        "id": "paused_cleaning",
        "title": {
          "en": "Cleaning was interrupted",
          "fr": "Le nettoyage a été interrompu"
        },
        "hint": {
          "en": "The robot paused while cleaning. Resume with 'Resume cleaning'.",
          "fr": "Le robot s'est arrêté pendant le nettoyage. Reprendre avec « Reprendre le nettoyage »."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=x20plus"
          }
        ],
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery",
              "fr": "Batterie"
            }
          },
          {
            "name": "area",
            "type": "number",
            "title": {
              "en": "Cleaned area",
              "fr": "Surface nettoyée"
            }
          }
        ]
      },
      {
        "id": "paused_returning",
        "title": {
          "en": "Return to dock was interrupted",
          "fr": "Le retour à la base a été interrompu"
        },
        "hint": {
          "en": "The robot paused on its way home. Resume with 'Resume return to dock' - never with 'Resume cleaning', which would start a new full clean.",
          "fr": "Le robot s'est arrêté en rentrant. Reprendre avec « Reprendre le retour à la base » - jamais avec « Reprendre le nettoyage », qui lancerait un nettoyage complet."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=x20plus"
          }
        ],
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery",
              "fr": "Batterie"
            }
          },
          {
            "name": "area",
            "type": "number",
            "title": {
              "en": "Cleaned area",
              "fr": "Surface nettoyée"
            }
          }
        ]
      },
      {
        "id": "error_returning",
        "title": {
          "en": "Robot is blocked returning to dock",
          "fr": "Le robot est bloqué en retour à la base"
        },
        "hint": {
          "en": "The robot hit an obstacle on its way home and is waiting. Resume with 'Resume return to dock'.",
          "fr": "Le robot a rencontré un obstacle en rentrant et attend. Reprendre avec « Reprendre le retour à la base »."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=x20plus"
          }
        ],
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery",
              "fr": "Batterie"
            }
          },
          {
            "name": "fault",
            "type": "number",
            "title": {
              "en": "Fault code",
              "fr": "Code d'erreur"
            }
          },
          {
            "name": "area",
            "type": "number",
            "title": {
              "en": "Cleaned area",
              "fr": "Surface nettoyée"
            }
          }
        ]
      },
      {
        "id": "error",
        "title": {
          "en": "Robot is blocked (error)",
          "fr": "Le robot est bloqué (erreur)"
        },
        "hint": {
          "en": "The robot stopped on an error outside a dock return. Beware: 'Resume cleaning' from here may start a new full clean.",
          "fr": "Le robot s'est arrêté sur une erreur hors retour à la base. Attention : « Reprendre le nettoyage » peut relancer un nettoyage complet."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=x20plus"
          }
        ],
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery",
              "fr": "Batterie"
            }
          },
          {
            "name": "fault",
            "type": "number",
            "title": {
              "en": "Fault code",
              "fr": "Code d'erreur"
            }
          },
          {
            "name": "area",
            "type": "number",
            "title": {
              "en": "Cleaned area",
              "fr": "Surface nettoyée"
            }
          }
        ]
      },
      {
        "id": "status_changed",
        "title": {
          "en": "Status changed",
          "fr": "L'état a changé"
        },
