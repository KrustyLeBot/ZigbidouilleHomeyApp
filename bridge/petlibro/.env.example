# Copy to .env next to docker-compose.yml. Nothing secret here: the Homey login lives in auth/htpasswd.

# Owner of /volume1/docker/petlibro-bridge/data (`ls -ln` on the NAS): the bridge writes there as this user.
PUID=1026
PGID=100

# Port Homey reaches the bridge on (Settings -> Petlibro in the Homey app: http://<NAS IP>:<API_PORT>).
API_PORT=8484

# Optional: comma-separated feeder serials allowed on the MQTT broker (the serial is in the Petlibro app, or in the
# bridge log the first time a feeder connects). Empty = any client id shaped like a Petlibro serial.
ALLOWED_SERIALS=

# Optional: LOG_LEVEL=debug logs one line per feeder message (heartbeats included). Off in normal use.
LOG_LEVEL=
