# Node
node_modules/
*.log

# Homey build output
.homeybuild/

# Local env (Zigbee needs no secrets, but keep this here in case a driver ever does)
.env

# Probe output — sweep dumps and watch traces. Machine data captured per device
# state: useful locally for diffing, noise in the history. Keep the scripts, not
# their output. A trace can also carry the device's own identifiers, so it has
# no business in a public repo.
probe/**/*.txt
probe/**/*.csv
probe/**/*.json

# Android Auto companion app (android-auto/) — build outputs and the local SDK
# path. The APK is rebuilt from source in seconds; local.properties points at
# one machine's SDK and has no business being shared.
android-auto/dist/
android-auto/local.properties
android-auto/.gradle/
android-auto/build/
android-auto/app/build/
