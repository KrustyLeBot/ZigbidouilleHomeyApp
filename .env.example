# Copy to .env at the repo root and fill in. .env is gitignored — the tokens
# below are passwords: never commit one, never paste one into a doc, an issue,
# or a log line.
#
# Only the miIO vacuums and the Imou cameras need credentials. Zigbee pairing is
# a radio handshake with nothing secret in it, so no Zigbee driver appears here.
#
# Read by probe/env.js as PREFIX_IP / PREFIX_TOKEN, e.g.:
#   cd probe/vacuum5 && node sweep.js save idle.txt
#
# The token is 32 hex characters. The Xiaomi app does not show it; it has to be
# extracted from the cloud account (Xiaomi Cloud Tokens Extractor and similar).
# The robot's IP is best pinned by a DHCP reservation — a lease change makes
# every probe fail with a handshake timeout, which looks exactly like a robot
# that is merely asleep.

# --- Xiaomi Robot Vacuum X20+ (xiaomi.vacuum.c102gl) ---
ROBOT_NAME=
ROBOT_MODEL=xiaomi.vacuum.c102gl
ROBOT_ID=
ROBOT_MAC=
ROBOT_IP=
ROBOT_TOKEN=

# Cloud region / home the device was extracted from. Not used at runtime — the
# app is entirely local — but useful when the token has to be pulled again.
XIAOMI_SERVER=
XIAOMI_HOME_ID=

# --- Xiaomi Robot Vacuum 5 (xiaomi.vacuum.ov31gl) ---
VACUUM5_NAME=
VACUUM5_MODEL=xiaomi.vacuum.ov31gl
VACUUM5_IP=
VACUUM5_TOKEN=

# --- Imou cameras (cloud) ---
#
# The ONLY cloud devices in this app, and a deliberate exception: privacy mode,
# PIR detection and the notification switches exist nowhere but the Imou cloud.
# There is no local protocol that reaches them (ONVIF gives the video stream and
# motion events, never these settings).
#
# Create an app at https://open.imoulife.com/consoleNew/myApp/appInfo and copy
# its credentials here. APP_SECRET is a password, exactly like a miIO token:
# never commit it, never paste it into a doc, an issue or a log line.
#
# Cameras already paired in the Imou Life phone app are shared to the developer
# account automatically — nothing to unbind, and the phone app keeps working.
# A developer account is capped at 5 devices and 30,000 API calls per MONTH —
# for the whole account, shared by every camera. Small enough that polling
# design matters; see the comments in app/lib/imou-camera-device.js.
IMOU_APP_ID=
IMOU_APP_SECRET=

# Data centre. Leave blank and the probe tries each one, reporting which
# answered — the console shows the region too, but this is quicker than hunting
# for it. Central Europe is openapi-fk.easy4ip.com.
IMOU_HOST=

# --- Somfy Protect alarm (cloud, UNOFFICIAL) ---
#
# No public developer API for Somfy Protect exists. This uses the same
# backend the phone app does, reverse-engineered by the community — it can
# break without notice if Somfy changes their app's auth. See the comments in
# app/lib/somfy-client.js and probe/somfy/probe.js.
#
# Use a SECONDARY account, not your own login: in the Somfy Protect app,
# Settings > add a user, role "owner", send yourself an invite to a separate
# email, accept it once. That account's credentials go here — revocable
# independently of the login that also guards your front door in person.
# SOMFY_PASSWORD is a password like any other: never commit it, never paste it
# into a doc or a log line.
SOMFY_EMAIL=
SOMFY_PASSWORD=
