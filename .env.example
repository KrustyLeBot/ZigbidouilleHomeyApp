# Copy to .env at the repo root and fill in. .env is gitignored — the tokens
# below are passwords: never commit one, never paste one into a doc, an issue,
# or a log line.
#
# Only the miIO devices need credentials. Zigbee pairing is a radio handshake
# with nothing secret in it, so no Zigbee driver appears here.
#
# Read by probe/env.js as PREFIX_IP / PREFIX_TOKEN, e.g.:
#   cd probe/vacuum5 && node sweep.js save idle.txt
#
# The token is 32 hex characters. The Xiaomi app does not show it; it has to be
# extracted from the cloud account (Xiaomi Cloud Tokens Extractor and similar).
# The robot's IP is best pinned by a DHCP reservation — a lease change makes
# every probe fail with a handshake timeout, which looks exactly like a robot
# that is merely asleep.

# --- Xiaomi Robot Vacuum X20+ (xiaomi.vacuum.c102gl) ---
ROBOT_NAME=
ROBOT_MODEL=xiaomi.vacuum.c102gl
ROBOT_ID=
ROBOT_MAC=
ROBOT_IP=
ROBOT_TOKEN=

# Cloud region / home the device was extracted from. Not used at runtime — the
# app is entirely local — but useful when the token has to be pulled again.
XIAOMI_SERVER=
XIAOMI_HOME_ID=

# --- Xiaomi Robot Vacuum 5 (xiaomi.vacuum.ov31gl) ---
VACUUM5_NAME=
VACUUM5_MODEL=xiaomi.vacuum.ov31gl
VACUUM5_IP=
VACUUM5_TOKEN=
